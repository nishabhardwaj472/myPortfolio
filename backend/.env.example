# .env example for portfolio backend
# Copy this file to .env and fill in the values.

# Server port (default 3000)
PORT=3000

# Frontend origin for CORS (e.g., your Vercel domain)
CORS_ORIGIN=https://your-frontend.vercel.app

# MongoDB Atlas connection string (optional)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# Resend email service API key
RESEND_API_KEY=your_resend_api_key

# Default "from" address for emails (must be verified in Resend)
RESEND_FROM=Portfolio <no-reply@yourdomain.com>

# Recipient email address for contact form submissions
CONTACT_RECIPIENT=you@example.com

# Fallback email if RESEND_FROM not set
RESEND_FROM_EMAIL=no-reply@example.com
