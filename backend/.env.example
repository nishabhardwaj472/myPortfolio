# .env.example — Copy this to .env and fill in your values.
# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Allowed frontend origin(s) for CORS.
# Use '*' to allow all (not recommended for production).
# For a single origin: https://your-portfolio.vercel.app
# For multiple origins (comma-separated): https://origin1.com,https://origin2.com
CORS_ORIGIN=*

# ── MongoDB (optional) ──────────────────────────────────────────────────────
# Uncomment to store contact submissions in MongoDB Atlas.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Resend ──────────────────────────────────────────────────────────────────
# Your Resend API key (get one at https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key

# Sender address — must be a verified domain/email in your Resend account.
# Format: Display Name <address@yourdomain.com>
#
# ⚠️  FREE PLAN RESTRICTION: Resend's free plan only allows sending from
#     onboarding@resend.dev — and ONLY to your own verified email address.
#     For any other sender address, you must verify the domain in Resend first.
#
# If this value contains a placeholder domain (example.com, yourdomain.com, etc.),
# the backend will automatically fall back to RESEND_FROM_EMAIL below.
RESEND_FROM=Portfolio <no-reply@example.com>

# Verified fallback sender address.
# Use onboarding@resend.dev for Resend's free plan (no domain verification needed).
# Replace with your own verified address once you verify a domain in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Recipient email — where contact form submissions will be delivered.
CONTACT_RECIPIENT=you@example.com
