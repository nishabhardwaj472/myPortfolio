# .env for portfolio backend
PORT=3000

# Allow both local Vite dev server and production frontend
CORS_ORIGIN=*

# ── Resend ──────────────────────────────────────────────────────────────────
# Set your real Resend API key here (get one at https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Sender address – must be a verified domain/email in your Resend account.
# Format: Display Name <address@yourdomain.com>
# NOTE: Resend's free plan allows sending from onboarding@resend.dev to your
#       own email only. For custom domains, verify the domain in Resend first.
RESEND_FROM=Portfolio <no-reply@yourdomain.com>

# Where contact-form submissions are delivered (your personal inbox)
CONTACT_RECIPIENT=nishabhardwaj843328@gmail.com

# Fallback sender address (used if RESEND_FROM is not set)
RESEND_FROM_EMAIL=no-reply@yourdomain.com
